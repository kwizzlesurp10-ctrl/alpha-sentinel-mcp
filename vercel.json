{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd dashboard && npm install && npm run build",
  "outputDirectory": "dashboard/dist",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/stats", "destination": "/api/stats" },
    { "source": "/doctor", "destination": "/api/doctor" },
    { "source": "/wallet", "destination": "/api/wallet" },
    { "source": "/pulse", "destination": "/api/pulse" },
    { "source": "/tools/(.*)", "destination": "/api/tools/$1" },
    { "source": "/quota/(.*)", "destination": "/api/quota/$1" },
    { "source": "/ledger/(.*)", "destination": "/api/ledger/$1" },
    { "source": "/swarm/(.*)", "destination": "/api/swarm/$1" },
    { "source": "/.well-known/(.*)", "destination": "/api/.well-known/$1" },
    { "source": "/docs", "destination": "/api/docs" },
    { "source": "/docs/(.*)", "destination": "/api/docs/$1" },
    { "source": "/openapi.json", "destination": "/api/openapi.json" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
