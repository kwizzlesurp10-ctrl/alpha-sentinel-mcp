# Alpha Sentinel MCP Server - Environment Configuration

# Copy this file to .env and fill in your credentials
# NEVER commit .env to version control!

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

HOST=0.0.0.0
PORT=8403
PUBLIC_BASE_URL=http://localhost:8403

# ============================================================================
# X402 SELLER CONFIGURATION (COLD WALLET - RECEIVE REVENUE)
# CRITICAL: This address must be SEPARATE from buyer wallet!
# ============================================================================

# Your receive address for x402 payments (SEPARATE from buyer!)
X402_PAY_TO_ADDRESS=

# Key provider type (env, keychain, or hardware)
KEY_PROVIDER=env

# ============================================================================
# X402 BUYER CONFIGURATION (HOT WALLET - SPENDING ONLY)
# ⚠️ NEVER PUT THIS ON RENDER/Vercel - Local Only!
# ============================================================================

# Buyer private key for paying upstream costs/swarm
EVM_PRIVATE_KEY=

# Network for revenue challenges (None = auto-resolve)
REVENUE_NETWORK=

# ============================================================================
# BASE NETWORK CONFIGURATION
# ============================================================================

BASE_RPC_URL=https://mainnet.base.org
ETH_PRICE_URL=https://api.coinbase.com/v2/prices/ETH-USD/spot

# CDP Facilitator (for mainnet selling)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_NETWORKS=eip155:8453

# Default network (Base Sepolia for dev/testing)
X402_DEFAULT_NETWORK=eip155:84532
X402_HTTP_TIMEOUT=90.0

# ============================================================================
# DATA SOURCE API KEYS
# ============================================================================

# CoinGecko API (free tier works, premium for higher limits)
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Twitter/X API v2 (for sentiment analysis)
X_API_KEY=

# Reddit API (for sentiment analysis)
REDDIT_API_ID=
REDDIT_API_SECRET=

# ============================================================================
# STRIPE FIAT RAIL (OPTIONAL - BACKUP PAYMENT METHOD)
# ============================================================================

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# QUOTA & PRICING (Advanced - usually don't change)
# ============================================================================

FREE_TIER_MONTHLY_QUOTA=500
FREE_TIER_RATE_LIMIT_PER_MIN=10

PRO_TIER_MONTHLY_QUOTA=50000
PRO_TIER_RATE_LIMIT_PER_MIN=120
PRO_TIER_PRICE=$29.00

TOOL_CREDIT_PACK_SIZE=100
TOOL_CREDIT_PACK_PRICE=$1.00

# ============================================================================
# REDIS FOR PRODUCTION STATE PERSISTENCE (Optional but recommended)
# ============================================================================

REDIS_URL=  # provisioned by Vercel Marketplace Upstash Redis
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ============================================================================
# OPERATOR CONFIGURATION
# ============================================================================

OPERATOR_TOKEN=  # Optional bearer token for /quota endpoint protection

# Dashboard actions gate (true enables POST endpoints)
DASHBOARD_ACTIONS=false

# Trust forwarded headers (only if behind trusted proxy)
TRUST_FORWARDED_HOST=false

# ============================================================================
# SWARM AGENCY (Buy-Compose-Resell)
# ============================================================================

SWARM_ENABLED=false
SWARM_MARKUP=3.0
SWARM_MIN_PRICE_USDC=0.01
SWARM_MAX_UPSTREAM_CALLS=3
SWARM_ALLOW_PAID_INPUTS=false
SWARM_TARGET_LTV_CAC=3.0
SWARM_MIN_MARGIN_RATIO=0.5
SWARM_SELL_NETWORK=eip155:84532

# Operator wallets for distinguishing real sales from self-payments
OPERATOR_WALLETS=

# Upstream URLs for swarm scouting (comma-separated)
SWARM_UPSTREAM_URLS=

# ============================================================================
# DISCOVERY & BAZAAR METADATA
# ============================================================================

BAZAAR_DISCOVERABLE=true
BAZAAR_SERVICE_NAME=Alpha Sentinel Market Intelligence
BAZAAR_SERVICE_TAGS=base,intelligence,crypto,market,x402,mcp

CONTACT_EMAIL=kwizzlesurp10@gmail.com

# Ownership proofs (sign with receive address, then paste signature here)
OWNERSHIP_PROOFS=

# ============================================================================
# ALPHA SENTINEL SPECIFIC THRESHOLDS
# ============================================================================

VOLATILITY_Z_SCORE_THRESHOLD=2.0
SENTIMENT_MOMENTUM_WINDOW=60
ALERT_COOLDOWN_SECONDS=300

REFLECTION_INTERVAL_SECONDS=3600
ACCURACY_THRESHOLD_FOR_PATCH=0.5

# ============================================================================
# DEVELOPMENT/TROUBLESHOOTING
# ============================================================================

LOG_LEVEL=INFO
